# Normalize line endings: LF in the repo, native in the working tree
* text=auto eol=lf

# Explicit text types
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf

# Binary — never touch these
*.png   binary
*.gif   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.pdf   binary
